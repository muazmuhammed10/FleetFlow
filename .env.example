# ============================================================
# FleetFlow Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Database -----
DATABASE_URL="postgresql://fleetflow_user:change_this_password@localhost:5432/fleetflow_db"

# ----- Backend -----
NODE_ENV=development
PORT=4000

# JWT / Session secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_byte_hex_string
JWT_REFRESH_SECRET=change_this_to_another_random_64_byte_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — set to the frontend origin
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ----- Frontend -----
VITE_API_URL=http://localhost:4000/api

# ----- Email (optional — uses Ethereal preview in dev if not set) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FleetFlow <no-reply@fleetflow.local>"

# ----- File uploads -----
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ----- Pricing / Tax -----
DEFAULT_TAX_RATE=0.10
DEFAULT_SECURITY_DEPOSIT=200.00

# ----- Dev seed admin (DEVELOPMENT ONLY — change before any deployment) -----
SEED_ADMIN_EMAIL=admin@fleetflow.dev
SEED_ADMIN_PASSWORD=Admin@FleetFlow2025!
